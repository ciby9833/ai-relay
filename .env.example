# 复制为 .env 后填写。.env 不入库。

# ---- 基础 ----
ENV=development                  # production 时强制关闭 DEV_LOGIN
SECRET_KEY=                      # 会话签名 + 飞书 token 加密，用 `openssl rand -hex 32` 生成
POSTGRES_PASSWORD=               # `openssl rand -hex 16`
FRONTEND_URL=http://localhost:5173
DEFAULT_TIMEZONE=Asia/Jakarta

# 宿主机端口（可选）
# BIND_ADDR=127.0.0.1
# API_PORT=8098
# WEB_PORT=5173
# DB_PORT=54329

# ---- 飞书 ----
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_TENANT_KEY=               # 只允许这个租户的成员登录
# 必须与飞书后台“安全设置 → 重定向 URL”里登记的完全一致
FEISHU_REDIRECT_URI=http://localhost:8098/api/auth/feishu/callback
# 登录时申请哪些用户权限由应用在飞书后台实际开通的权限决定，无需配置
# 机器人收消息默认走长连接（feishu 服务），不需要下面两项；
# 只有改用 HTTP 回调地址（/api/feishu/events）时才需要填写
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# ---- 模型（填了哪家的 key 就启用哪家）----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Gemini 也可以用 Google Cloud 服务账号走 Vertex AI（优先于 GEMINI_API_KEY）：
# 填凭证文件相对本目录的路径，compose 会把它只读挂进容器
GOOGLE_CREDENTIALS_FILE=
# GOOGLE_CLOUD_PROJECT=           # 默认取凭证文件里的 project_id
# GOOGLE_CLOUD_LOCATION=global
# 每家可选的模型，逗号分隔
ANTHROPIC_MODELS=claude-opus-5-5,claude-haiku-5-5
OPENAI_MODELS=gpt-5
GEMINI_MODELS=gemini-4-argon
# 主动流程（邮件分级、起草回复、简报）用的模型，留空用默认模型；量大时可换便宜的模型
TRIAGE_MODEL=
# 默认模型，格式 provider:model；留空则取第一个可用的
DEFAULT_MODEL=gemini:gemini-4-argon
# 记忆向量化用的模型，格式 provider:model（openai 或 gemini）；留空自动选择
# 更换后旧向量不再参与语义检索
EMBEDDING_MODEL=

# ---- 开发 ----
DEV_LOGIN=false                  # true 时可免飞书登录（仅本地调试）
