#!/bin/sh
set -eu
[ "$(git rev-parse --show-toplevel)" = /Users/ellis/Documents/CargoPPT/relay ] || { echo '拒绝推送：目录不符合白名单。' >&2; exit 1; }
[ "$2" = https://github.com/ciby9833/ai-relay.git ] || { echo '拒绝推送：仓库不符合白名单。' >&2; exit 1; }
while read -r local_ref local_oid remote_ref remote_oid; do
  [ "$local_ref" = refs/heads/main ] && [ "$remote_ref" = refs/heads/main ] && [ "$local_oid" = "$(git rev-parse HEAD)" ] || { echo '只允许推送当前 main，禁止推送其他引用。' >&2; exit 1; }
done
python3 scripts/check_release.py --history
